              "body": "{\n  \"data\": [\n    {\n      \"context_attributes\": {\n        \"hunting_info\": {\n          \"rule_name\": \"<string>\"\n        },\n        \"notification_date\": 0,\n        \"notification_id\": \"<string>\",\n        \"origin\": \"<string>\",\n        \"sources\": [\n          {\n            \"id\": \"<string>\",\n            \"label\": \"<string>\",\n            \"type\": \"<string>\"\n          },\n          {\n            \"id\": \"<string>\",\n            \"label\": \"<string>\",\n            \"type\": \"<string>\"\n          }\n        ],\n        \"tags\": [\n          \"<string>\",\n          \"<string>\"\n        ]\n      },\n      \"id\": \"<string>\",\n      \"type\": \"<string>\"\n    },\n    {\n      \"context_attributes\": {\n        \"hunting_info\": {\n          \"rule_name\": \"<string>\"\n        },\n        \"notification_date\": 0,\n        \"notification_id\": \"<string>\",\n        \"origin\": \"<string>\",\n        \"sources\": [\n          {\n            \"id\": \"<string>\",\n            \"label\": \"<string>\",\n            \"type\": \"<string>\"\n          },\n          {\n            \"id\": \"<string>\",\n            \"label\": \"<string>\",\n            \"type\": \"<string>\"\n          }\n        ],\n        \"tags\": [\n          \"<string>\",\n          \"<string>\"\n        ]\n      },\n      \"id\": \"<string>\",\n      \"type\": \"<string>\"\n    }\n  ],\n  \"links\": {\n    \"next\": \"<string>\",\n    \"self\": \"<string>\"\n  },\n  \"meta\": {\n    \"cursor\": \"<string>\"\n  }\n}",
