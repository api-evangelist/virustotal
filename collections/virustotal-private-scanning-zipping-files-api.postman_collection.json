                  "key": "key",
                  "value": "x-apikey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"{\\\"password\\\": \\\"<password>\\\", \\\"hashes\\\":[\\\"<hash1>\\\", \\\"<hash2>\\\"]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
