                {
                  "name": "VirusTotal Check a ZIP File\u2019s Status",
                  "id": "c0d3b20e-0874-4139-9354-f242d5c38a9a",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "apikey",
                      "apikey": [
