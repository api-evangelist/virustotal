                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/users/:id/api_usage?start_date=<string>&end_date=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "users",
                        ":id",
                        "api_usage"
                      ],
                      "query": [
                        {
                          "description": "A string in format YYYYMMDD",
                          "key": "start_date",
                          "value": "<string>"
                        },
                        {
                          "description": "A string in format YYYYMMDD",
