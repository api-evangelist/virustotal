                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Return the rules matching the given criteria only"
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Continuation cursor"
                }
              ],
              "variable": []
