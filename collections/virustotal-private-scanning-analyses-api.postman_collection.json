                ],
                "url": {
                  "raw": "{{baseUrl}}/private/analyses?limit=10&cursor=<string>&order=date-",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "private",
                    "analyses"
                  ],
                  "query": [
                    {
                      "description": "Maximum number of files to retrieve (40 max)",
                      "key": "limit",
