          "id": "9f2381d6-73e1-431a-b181-f7cbe3afa0d9",
          "name": "VirusTotal Get Object Descriptors Related to a User",
          "request": {
            "name": "VirusTotal Get Object Descriptors Related to a User",
            "description": {
              "content": "This endpoint is the same as [/users/{id}/{relationship}](https://gtidocs.virustotal.com/reference/users-relationships) except it returns just the related object's IDs (and context attributes, if any) instead of returning all attributes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":id",
                "relationships",
                ":relationship"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of related objects to retrieve"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Continuation cursor"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Username or API key"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "relationship",
                  "description": "(Required) Relationship name (see [table](ref:user-object#relationships))"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-apikey"
                },
