                {
                  "name": "VirusTotal Get a Private Analysis",
                  "id": "d46da789-4e28-4101-9c7c-355137a38414",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "apikey",
                      "apikey": [
                        {
                          "key": "key",
